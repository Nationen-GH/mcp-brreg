# Copy to .env and adjust. Nothing here is required for local stdio use.

# stdio | http   (sse still accepted as a deprecated alias for http)
TRANSPORT=stdio

# HTTP transport only
PORT=3000
HOST=0.0.0.0

# Required for any network-reachable deployment. Generate one with:
#   openssl rand -hex 32
AUTH_TOKEN=

# Comma-separated browser origins allowed by CORS, or * for any.
ALLOWED_ORIGINS=*

# Upstream client tuning (all optional)
BRREG_BASE_URL=https://data.brreg.no
BRREG_TIMEOUT_MS=30000
BRREG_MAX_RETRIES=3
BRREG_CACHE_TTL_MS=300000

# Override the bundled SN2025 classification with your own dump.
# BRREG_NACE_DATA=/path/to/nace-codes-full.json
